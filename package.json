{
  "name": "oddsockets-nodejs",
  "version": "1.0.5",
  "description": "Official Node.js SDK for OddSockets real-time messaging platform",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "docs": "jsdoc src/*.js -d docs/",
    "swagger": "node swagger/server.js",
    "example": "node examples/basic-usage.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "oddsockets",
    "websocket",
    "realtime",
    "messaging",
    "pubsub",
    "pubnub",
    "pusher",
    "socket.io",
    "nodejs",
    "server-side"
  ],
  "author": "Joe Wee <joe@tyga.cloud>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/jyswee/oddsockets-nodejs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/jyswee/oddsockets-nodejs-sdk/issues"
  },
  "homepage": "https://docs.oddsockets.com/sdks/nodejs",
  "dependencies": {
    "socket.io-client": "^4.7.2",
    "axios": "^1.5.0",
    "eventemitter3": "^5.0.1",
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "jsdoc": "^4.0.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE"
  ]
}
